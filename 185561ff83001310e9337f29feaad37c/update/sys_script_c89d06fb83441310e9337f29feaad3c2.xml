        <script><![CDATA[(function executeRule(current, previous) {

    var gr = new GlideRecord('x_2088858_incide_0_incident');
    gr.orderByDesc('incident_number');
    gr.setLimit(1);
    gr.query();

    var nextNum = 1;

    if (gr.next()) {

        var lastNumber = gr.incident_number + '';
        var numberPart = lastNumber.replace('INC', '');

        if (!isNaN(parseInt(numberPart))) {
            nextNum = parseInt(numberPart) + 1;
        }
    }

    current.incident_number =
        'INC' + ('000000' + nextNum).slice(-6);

})(current, previous);]]></script>
