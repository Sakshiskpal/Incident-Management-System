        <script><![CDATA[(function executeRule(current, previous) {

    var priority = current.priority + '';

    if (current.sla_due_date)
        return;

    var gdt = new GlideDateTime(current.sys_created_on);

    if (priority == 'p1_critical') {
        gdt.addSecondsUTC(4 * 60 * 60);
    }
    else if (priority == 'p2_high') {
        gdt.addSecondsUTC(8 * 60 * 60);
    }
    else if (priority == 'p3_medium') {
        gdt.addSecondsUTC(24 * 60 * 60);
    }
    else if (priority == 'p4_low') {
        gdt.addSecondsUTC(48 * 60 * 60);
    }

    current.sla_due_date = gdt;

})(current, previous);]]></script>
