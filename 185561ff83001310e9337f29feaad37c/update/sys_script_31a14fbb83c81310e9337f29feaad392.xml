        <script><![CDATA[(function executeRule(current, previous) {

    if (current.resolved_on.nil() || current.sla_due_date.nil())
        return;

    var resolved = new GlideDateTime(current.resolved_on);
    var due = new GlideDateTime(current.sla_due_date);

    if (resolved.after(due)) {
        current.sla_status = 'breached';
    } else {
        current.sla_status = 'within_sla';
    }

})(current, previous);]]></script>
